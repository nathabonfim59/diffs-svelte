{
	"name": "diffs-svelte",
	"version": "0.1.0",
	"description": "Svelte 5 components for @pierre/diffs",
	"license": "MIT",
	"author": "Nathanael Bonfim",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nathabonfim59/diffs-svelte.git"
	},
	"homepage": "https://nathabonfim59.github.io/diffs-svelte/",
	"bugs": "https://github.com/nathabonfim59/diffs-svelte/issues",
	"keywords": [
		"svelte",
		"diff",
		"code",
		"syntax-highlighting",
		"shiki",
		"pierre-diffs"
	],
	"type": "module",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package && publint",
		"build:docs": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepublishOnly": "pnpm build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"pack:smoke": "./scripts/pack-smoke.sh",
		"release:check": "node scripts/validate-release.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@pierre/diffs": "^1.5.1",
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@pierre/diffs": "^1.5.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.2",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"packageManager": "pnpm@11.13.0"
}
